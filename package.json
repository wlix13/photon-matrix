{
  "name": "photon-matrix",
  "version": "0.1.0",
  "description": "Matrix homeserver running on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev -c wrangler.local.jsonc",
    "deploy": "wrangler deploy -c wrangler.local.jsonc",
    "db:migrate": "wrangler d1 execute tuwunel-db --file=./migrations/schema.sql",
    "db:migrate:local": "wrangler d1 execute tuwunel-db --local --file=./migrations/schema.sql",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20260721.1",
    "hono": "^4.12.25"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.2.6",
    "wrangler": "^4.112.0"
  }
}
